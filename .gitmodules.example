# .gitmodules.example
#
# Commented stubs for a future split of plugins/* into git submodules.
# This file is an example only. It is not named .gitmodules, and every
# entry is commented, so Git will not register or fetch anything.
# Replace <repository url> when a plugin gets its own repository.
#
# [submodule "plugins/NP_Language"]
# 	path = plugins/NP_Language
# 	url = <repository url for NP_Language>
#
# [submodule "plugins/NP_VideoPortrait"]
